      },
      "status": "accepted",
      "title": "PostgreSQL instead of SQLite",
      "unresolvedRelatedServices": []
    },
    {
      "consequences": [
        "Nginx becomes the only service with public ports.",
        "Certificate renewal must be monitored separately."
      ],
      "context": "The application needs public HTTP routing, but the database and cache must not be directly reachable from the internet.",
      "date": "2026-10-14",
      "decision": "Terminate TLS in Nginx on the edge network. Keep PostgreSQL, Redis and the worker on an internal network with no published ports.",
