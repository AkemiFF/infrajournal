    {
      "consequences": [
        "Database backup and restore procedures are required.",
        "The database must be upgraded on a planned maintenance cadence."
      ],
      "context": "Multiple application services need shared persistent data, and the worker performs concurrent writes while the web application serves requests.",
      "date": "2026-10-12",
      "decision": "Use PostgreSQL 16 as the application database and keep all application services on the private internal network.",
      "id": "decision:adr-001",
      "relatedServices": [
        "service:journal-demo:postgres",
        "service:journal-demo:web",
