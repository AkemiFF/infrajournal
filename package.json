{
  "name": "infrajournal",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-first infrastructure documentation generator.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @infrajournal/core build && pnpm --filter @infrajournal/documentation build && pnpm --filter @infrajournal/web build && pnpm --filter infrajournal build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && vitest run --config vitest.config.ts",
    "test:unit": "pnpm -r test",
    "test:e2e": "pnpm build && vitest run --config vitest.config.ts",
    "demo": "pnpm build && node scripts/demo.mjs",
    "schema": "pnpm --filter @infrajournal/core schema",
    "benchmark": "pnpm --filter @infrajournal/core build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
